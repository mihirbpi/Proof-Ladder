---
// Noodle the cat — the recurring l1/l2 character (§1.1 and after).
//
// mood        "awake"  eyes open, tail up
//             "sleepy" eyes closed, curled tail, three z's
// numberLegs  print 1–4 under the legs. §1.1 l1 says "Count them. One, two,
//             three, four", so the picture has to make four legs countable;
//             this makes the counting explicit for a reader who is still learning to.
export interface Props {
  mood?: 'awake' | 'sleepy';
  numberLegs?: boolean;
}
const { mood = 'awake', numberLegs = false } = Astro.props;
const sleepy = mood === 'sleepy';

// Four legs, in two pairs so they read as separate at a glance.
const legs = [88, 112, 152, 176];

const alt = sleepy
  ? 'Noodle, a stripy ginger cat, curled up asleep with her eyes closed and three little z letters floating above her.'
  : `Noodle, a stripy ginger cat, standing side-on with her tail up. She has one head, two pointed ears, a long tail, and four legs${numberLegs ? ', numbered one to four' : ''}.`;
---
<svg viewBox="0 0 290 190" xmlns="http://www.w3.org/2000/svg" class="noodle"
     role="img" aria-label={alt}>
  <style>
    .noodle .fur    { fill: var(--color-fur, #C98A55); stroke: var(--color-ink, #14182B); stroke-width: 2.4; stroke-linejoin: round; }
    .noodle .fur-in { fill: var(--color-fur-dark, #A96F3E); stroke: none; }
    .noodle .line   { fill: none; stroke: var(--color-ink, #14182B); stroke-width: 2.4; stroke-linecap: round; }
    .noodle .thin   { fill: none; stroke: var(--color-ink, #14182B); stroke-width: 1.6; stroke-linecap: round; }
    .noodle .eye    { fill: var(--color-ink, #14182B); }
    .noodle .nose   { fill: var(--color-toy-red, #C2503F); stroke: var(--color-ink, #14182B); stroke-width: 1.4; stroke-linejoin: round; }
    .noodle .num    { font-family: var(--font-mono, monospace); font-size: 13px; fill: color-mix(in oklab, var(--color-ink, #14182B) 70%, transparent); }
    .noodle .zzz    { font-family: var(--font-display, sans-serif); font-weight: 700; fill: color-mix(in oklab, var(--color-ink, #14182B) 55%, transparent); }
  </style>

  {/* tail — up and curling when awake, tucked round the body when asleep */}
  {sleepy ? (
    <path d="M 74 112 C 40 122, 34 148, 66 150 C 84 151, 92 142, 90 132" class="line" />
  ) : (
    <path d="M 76 96 C 40 96, 26 62, 44 40 C 52 30, 66 32, 68 44" class="line" />
  )}

  {/* legs, drawn behind the body so they tuck under it */}
  {!sleepy && legs.map((x) => (
    <rect x={x} y="112" width="15" height="42" rx="7" class="fur" />
  ))}

  {/* body */}
  {sleepy
    ? <ellipse cx="132" cy="118" rx="62" ry="36" class="fur" />
    : <ellipse cx="132" cy="98" rx="58" ry="33" class="fur" />}

  {/* stripes */}
  {!sleepy && (
    <g class="thin">
      <path d="M 112 70 q 8 12 0 24" />
      <path d="M 132 68 q 9 14 0 28" />
      <path d="M 152 70 q 8 12 0 24" />
    </g>
  )}

  {/* head */}
  <g transform={sleepy ? 'translate(-6 26)' : ''}>
    {/* ears */}
    <path d="M 178 48 L 172 16 L 202 34 Z" class="fur" />
    <path d="M 216 34 L 240 14 L 236 48 Z" class="fur" />
    <circle cx="204" cy="66" r="33" class="fur" />

    {sleepy ? (
      <g class="line">
        <path d="M 186 64 q 8 7 16 0" />
        <path d="M 210 64 q 8 7 16 0" />
      </g>
    ) : (
      <g>
        <circle cx="193" cy="62" r="4.2" class="eye" />
        <circle cx="217" cy="62" r="4.2" class="eye" />
      </g>
    )}

    <path d="M 204 76 l -6 -5 h 12 Z" class="nose" />
    <path d="M 204 76 v 6" class="thin" />

    {/* whiskers */}
    <g class="thin">
      <path d="M 176 78 h -22" />
      <path d="M 177 85 l -21 6" />
      <path d="M 232 78 h 22" />
      <path d="M 231 85 l 21 6" />
    </g>
  </g>

  {sleepy && (
    <g class="zzz">
      <text x="196" y="52" font-size="15">z</text>
      <text x="214" y="38" font-size="19">z</text>
      <text x="236" y="22" font-size="24">z</text>
    </g>
  )}

  {numberLegs && !sleepy && legs.map((x, i) => (
    <text x={x + 7} y="172" class="num" text-anchor="middle">{i + 1}</text>
  ))}
</svg>

<style>
  .noodle { width: 100%; height: auto; max-width: 290px; display: block; margin: 0 auto; }
</style>
