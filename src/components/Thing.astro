---
// One small drawn object, for the l1/l2 storybook figures.
//
// Renders a <g> positioned at (x, y) — its own centre — so it can be dropped
// inside any parent <svg>: a box of things, a hoop, a cubby. Every object is
// drawn inside a nominal 40x40 cell and scaled by `size / 40`.
//
// Objects were chosen from what the l1/l2 pages actually name. Each has a
// distinct SILHOUETTE as well as a distinct colour, because these end up inside
// sorting arguments where telling one from another is the whole point (§C8).
export interface Props {
  kind: 'ball' | 'sock' | 'hat' | 'apple' | 'cookie' | 'half-cookie' | 'orange' | 'shirt' | 'pea' | 'cat' | 'dog' | 'duck' | 'block' | 'star' | 'book' | 'coat';
  x?: number;
  y?: number;
  size?: number;
  color?: 'red' | 'blue' | 'green' | 'yellow' | 'orange' | null;
}
const { kind, x = 0, y = 0, size = 40, color = null } = Astro.props;

// Each object has a natural colour; `color` overrides it where a page needs a
// red one specifically ("here comes a red ball", "here comes a red sock").
const natural: Record<string, string> = {
  ball: 'red', sock: 'blue', hat: 'green', apple: 'red', cookie: 'yellow', 'half-cookie': 'yellow', orange: 'orange', shirt: 'red', pea: 'green', cat: 'red', dog: 'yellow', duck: 'yellow',
  block: 'blue', star: 'yellow', book: 'green', coat: 'red',
};
const hue = `var(--color-toy-${color ?? natural[kind]})`;
const s = size / 40;
---
<g transform={`translate(${x} ${y}) scale(${s}) translate(-20 -20)`} class="thing">
  {kind === 'ball' && (
    <g>
      <circle cx="20" cy="20" r="16" fill={hue} class="tk" />
      <path d="M 6 16 q 14 8 28 0" class="tl" />
      <path d="M 20 4 v 32" class="tl" />
    </g>
  )}

  {kind === 'apple' && (
    <g>
      <path d="M 20 10 C 10 4, 2 14, 6 24 C 9 32, 16 37, 20 33 C 24 37, 31 32, 34 24 C 38 14, 30 4, 20 10 Z" fill={hue} class="tk" />
      <path d="M 20 11 v -6" class="tl" />
      <path d="M 21 6 q 8 -5 9 2 q -6 3 -9 -2 Z" fill="var(--color-toy-green)" class="tk" />
    </g>
  )}

  {kind === 'cookie' && (
    <g>
      <circle cx="20" cy="20" r="15" fill={hue} class="tk" />
      <g fill="var(--color-ink, #14182B)" opacity="0.65">
        <circle cx="14" cy="15" r="2.2" /><circle cx="25" cy="13" r="2" />
        <circle cx="27" cy="24" r="2.2" /><circle cx="15" cy="26" r="2" />
        <circle cx="20" cy="20" r="1.8" />
      </g>
    </g>
  )}

  {kind === 'half-cookie' && (
    <g>
      <path d="M 20 5 A 15 15 0 0 0 20 35 Z" fill={hue} class="tk" />
      <g fill="var(--color-ink, #14182B)" opacity="0.65">
        <circle cx="13" cy="15" r="2.2" /><circle cx="11" cy="26" r="2" />
        <circle cx="16" cy="21" r="1.8" />
      </g>
    </g>
  )}

  {kind === 'orange' && (
    <g>
      <circle cx="20" cy="21" r="15" fill={hue} class="tk" />
      {/* dimpled peel, so it is not just a differently coloured ball */}
      <path d="M 20 6 v 4" class="tl" />
      <path d="M 21 9 q 7 -4 8 1 q -5 3 -8 -1 Z" fill="var(--color-toy-green)" class="tk" />
      <g class="tl" opacity="0.45">
        <path d="M 9 17 q 11 5 22 0" />
        <path d="M 9 26 q 11 -5 22 0" />
      </g>
    </g>
  )}

  {kind === 'shirt' && (
    <g>
      <path d="M 14 8 L 20 13 L 26 8 L 35 12 l -4 9 l -3 -1 v 14 H 12 V 20 l -3 1 l -4 -9 Z" fill={hue} class="tk" />
      <path d="M 14 8 q 6 8 12 0" class="tl" />
    </g>
  )}

  {kind === 'pea' && (
    <g>
      <circle cx="14" cy="24" r="7" fill={hue} class="tk" />
      <circle cx="26" cy="22" r="7" fill={hue} class="tk" />
      <circle cx="20" cy="13" r="7" fill={hue} class="tk" />
    </g>
  )}

  {/* Three animals, small. Each is a distinct silhouette — pointed ears, a
      floppy ear, a bill — so they are told apart at 38px without colour. */}
  {kind === 'cat' && (
    <g>
      <path d="M 9 14 L 8 4 L 17 10 Z" fill={hue} class="tk" />
      <path d="M 31 14 L 32 4 L 23 10 Z" fill={hue} class="tk" />
      <circle cx="20" cy="21" r="14" fill={hue} class="tk" />
      <circle cx="15" cy="19" r="1.9" class="tf" />
      <circle cx="25" cy="19" r="1.9" class="tf" />
      <path d="M 20 25 l -3 -3 h 6 Z" class="tf" />
      <g class="tl"><path d="M 6 24 h -4" /><path d="M 34 24 h 4" /></g>
    </g>
  )}
  {kind === 'dog' && (
    <g>
      <ellipse cx="20" cy="22" rx="13" ry="12" fill={hue} class="tk" />
      <path d="M 8 12 C 1 14, 2 27, 9 26 Z" fill={hue} class="tk" />
      <path d="M 32 12 C 39 14, 38 27, 31 26 Z" fill={hue} class="tk" />
      <circle cx="16" cy="20" r="1.9" class="tf" />
      <circle cx="24" cy="20" r="1.9" class="tf" />
      <ellipse cx="20" cy="27" rx="4" ry="3" class="tf" />
    </g>
  )}
  {kind === 'duck' && (
    <g>
      <ellipse cx="18" cy="26" rx="14" ry="9" fill={hue} class="tk" />
      <circle cx="27" cy="15" r="8" fill={hue} class="tk" />
      <path d="M 34 14 l 7 2 l -7 3 Z" fill="var(--color-toy-orange)" class="tk" />
      <circle cx="29" cy="13" r="1.7" class="tf" />
    </g>
  )}

  {kind === 'block' && (
    <g>
      <rect x="6" y="8" width="28" height="26" rx="4" fill={hue} class="tk" />
      <rect x="12" y="14" width="16" height="14" rx="2" fill="none" class="tl" opacity="0.55" />
    </g>
  )}

  {kind === 'star' && (
    <path d="M 20 3 L 25 15 L 38 16 L 28 24 L 31 37 L 20 30 L 9 37 L 12 24 L 2 16 L 15 15 Z"
          fill={hue} class="tk" />
  )}

  {kind === 'sock' && (
    <path d="M 13 4 h 12 v 18 q 0 6 5 8 l 5 3 q 4 3 1 6 l -5 3 q -4 2 -7 -1 l -9 -8 q -4 -4 -4 -10 Z"
          fill={hue} class="tk" />
  )}

  {kind === 'hat' && (
    <g>
      <path d="M 11 24 q 9 -20 18 0 Z" fill={hue} class="tk" />
      <rect x="3" y="23" width="34" height="6" rx="3" fill={hue} class="tk" />
    </g>
  )}

  {kind === 'book' && (
    <g>
      <rect x="7" y="7" width="26" height="27" rx="2" fill={hue} class="tk" />
      <path d="M 13 7 v 27" class="tl" opacity="0.6" />
      <path d="M 19 14 h 9 M 19 20 h 9 M 19 26 h 6" class="tl" opacity="0.5" />
    </g>
  )}

  {kind === 'coat' && (
    <g>
      <path d="M 14 8 L 20 12 L 26 8 L 34 13 l -3 8 l -3 -1 v 14 H 12 V 20 l -3 1 l -3 -8 Z"
            fill={hue} class="tk" />
      <path d="M 20 12 v 22" class="tl" opacity="0.6" />
    </g>
  )}
</g>

<style is:global>
  .thing .tk { stroke: var(--color-ink, #14182B); stroke-width: 2; stroke-linejoin: round; }
  .thing .tf { fill: var(--color-ink, #14182B); }
  .thing .tl { fill: none; stroke: var(--color-ink, #14182B); stroke-width: 1.6; stroke-linecap: round; }
</style>
