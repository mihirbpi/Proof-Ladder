---
// A row of toy blocks, for §1.2 and §1.3 at l1/l2 — "all the blocks are red",
// and the one green block that knocks that telling down.
//
// colors    one entry per block: "red" | "blue" | "green" | "yellow"
// spotlight index of a block to ring, for "even one tiny green block would do"
//
// Each color also gets its own PATTERN (plain, dots, stripes, checks), because
// the whole argument on those pages turns on telling one block from the others,
// and a reader who cannot separate the hues must still be able to (§C8).
export interface Props {
  colors?: ('red' | 'blue' | 'green' | 'yellow')[];
  spotlight?: number | null;
  label?: string | null;
}
const { colors = ['red', 'red', 'red'], spotlight = null, label = null } = Astro.props;

const SIZE = 54;
const GAP = 14;
const PAD = 16;
const W = PAD * 2 + colors.length * SIZE + (colors.length - 1) * GAP;
const H = PAD * 2 + SIZE + (label ? 26 : 0) + 10;

const fillFor = (c: string) => `var(--color-toy-${c})`;
// Pattern per color, so hue is never the only difference.
const patternFor = (c: string) =>
  ({ red: 'plain', blue: 'dots', green: 'stripes', yellow: 'checks' } as const)[c] ?? 'plain';

const counts = colors.reduce<Record<string, number>>((m, c) => ({ ...m, [c]: (m[c] ?? 0) + 1 }), {});
const tally = Object.entries(counts).map(([c, n]) => `${n} ${c}`).join(' and ');
const alt = `A row of ${colors.length} toy blocks: ${tally}.`
  + (spotlight !== null ? ` The ${colors[spotlight]} one is ringed.` : '')
  + ' Each color also has its own pattern, so they can be told apart without relying on color.';
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" class="blocks"
     role="img" aria-label={alt}>
  <style>
    .blocks .cube { stroke: var(--color-ink, #14182B); stroke-width: 2.4; stroke-linejoin: round; }
    .blocks .ring { fill: none; stroke: var(--color-ink, #14182B); stroke-width: 2.6; stroke-dasharray: 6 5; }
    .blocks .cap  { font-family: var(--font-display, sans-serif); font-size: 14px; font-weight: 600; fill: var(--color-ink, #14182B); }
  </style>

  <defs>
    <pattern id="bk-dots" width="10" height="10" patternUnits="userSpaceOnUse">
      <circle cx="5" cy="5" r="2" fill="var(--color-ink, #14182B)" opacity="0.34" />
    </pattern>
    <pattern id="bk-stripes" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="4" height="10" fill="var(--color-ink, #14182B)" opacity="0.28" />
    </pattern>
    <pattern id="bk-checks" width="12" height="12" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="var(--color-ink, #14182B)" opacity="0.28" />
      <rect x="6" y="6" width="6" height="6" fill="var(--color-ink, #14182B)" opacity="0.28" />
    </pattern>
  </defs>

  {colors.map((c, i) => {
    const x = PAD + i * (SIZE + GAP);
    const y = PAD;
    const pat = patternFor(c);
    return (
      <g>
        <rect x={x} y={y} width={SIZE} height={SIZE} rx="8" class="cube" fill={fillFor(c)} />
        {pat !== 'plain' && (
          <rect x={x} y={y} width={SIZE} height={SIZE} rx="8" fill={`url(#bk-${pat})`} stroke="none" />
        )}
        {spotlight === i && (
          <rect x={x - 6} y={y - 6} width={SIZE + 12} height={SIZE + 12} rx="12" class="ring" />
        )}
      </g>
    );
  })}

  {label && <text x={W / 2} y={PAD + SIZE + 26} class="cap" text-anchor="middle">{label}</text>}
</svg>

<style>
  .blocks { width: 100%; height: auto; max-width: 340px; display: block; margin: 0 auto; }
</style>
