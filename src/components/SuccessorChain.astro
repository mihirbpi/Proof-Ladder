---
// The successor chain 0 → S(0) → S(S(0)) → … (§7.3–§7.5), with variants for the
// broken models §7.4 builds to show A7 and A8 are independent.
//
// mode:
//   "chain"   0 → 1 → 2 → … running off to the right. The real ℕ.
//   "loop"    a cycle: the last node points back to 0. Violates A7, since
//             something has 0 as its successor.
//   "merge"   two nodes share a successor. Violates A8 (S is not injective).
//   "rogue"   the chain, plus two extra nodes off to one side pointing at each
//             other — satisfies A5–A8 and is excluded only by A9.
//
// labels    node labels; defaults to 0, 1, 2, … for the chain length given
// count     how many chain nodes to draw
export interface Props {
  mode?: 'chain' | 'loop' | 'merge' | 'rogue';
  count?: number;
  labels?: string[] | null;
  rogueLabels?: [string, string];
}
const {
  mode = 'chain',
  count = 4,
  labels = null,
  rogueLabels = ['a', 'b'],
} = Astro.props;

const R = 16;
const GAP = 78;
const LEFT = 34;
const ROW_Y = mode === 'rogue' ? 54 : (mode === 'merge' ? 92 : 62);
const W = 480;
const H = mode === 'rogue' ? 168 : (mode === 'loop' ? 128 : (mode === 'merge' ? 132 : 104));

const n = mode === 'loop' ? Math.min(count, 4) : count;
const nodes = Array.from({ length: n }, (_, i) => ({
  i,
  x: LEFT + i * GAP,
  y: ROW_Y,
  label: labels?.[i] ?? String(i),
}));

const trailing = mode === 'chain' || mode === 'rogue';

const alt = {
  chain: `A chain of dots labeled ${nodes.map((d) => d.label).join(', ')}, each with an arrow to the next, continuing to the right without end.`,
  loop: `A cycle of ${n} dots, each with an arrow to the next, and the last arrow curving back to 0 — so 0 is the successor of something, which the axioms forbid.`,
  merge: `A chain of dots ${nodes.map((d) => d.label).join(', ')}, each with an arrow to the next, and the last dot also carrying an arrow back to itself — so two different dots have the same successor and the successor operation is not injective.`,
  rogue: `The ordinary chain of dots 0, 1, 2, … continuing to the right, and separately two extra dots ${rogueLabels[0]} and ${rogueLabels[1]} pointing at each other in a two-cycle, unreachable from 0 by counting.`,
}[mode];
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" class="succ-chain"
     role="img" aria-label={alt}>
  <style>
    .succ-chain .node { fill: var(--color-card, #F8F9F5); stroke: var(--color-ink, #14182B); stroke-width: 1.6; }
    .succ-chain .node-bad { fill: color-mix(in oklab, var(--color-false, #A8324A) 12%, var(--color-card, #F8F9F5)); stroke: var(--color-false, #A8324A); stroke-width: 1.6; }
    .succ-chain .lbl { font-family: var(--font-mono, monospace); font-size: 12px; fill: var(--color-ink, #14182B); }
    .succ-chain .arr { fill: none; stroke: var(--color-ink, #14182B); stroke-width: 1.4; }
    .succ-chain .arr-bad { fill: none; stroke: var(--color-false, #A8324A); stroke-width: 1.6; }
    .succ-chain .dots { font-family: var(--font-mono, monospace); font-size: 18px; fill: color-mix(in oklab, var(--color-ink, #14182B) 55%, transparent); }
    .succ-chain .note { font-family: var(--font-mono, monospace); font-size: 10px; fill: var(--color-false, #A8324A); }
  </style>

  <defs>
    <marker id="sc-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-ink, #14182B)" />
    </marker>
    <marker id="sc-a-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-false, #A8324A)" />
    </marker>
  </defs>

  {/* Forward arrows along the chain, i → i+1. In merge mode the last of these
      is one of the two arrows landing on the final node, so it is marked. */}
  {nodes.slice(0, n - 1).map((d) => (
    <line x1={d.x + R + 3} y1={d.y} x2={d.x + GAP - R - 6} y2={d.y}
          class={mode === 'merge' && d.i === n - 2 ? 'arr-bad' : 'arr'}
          marker-end={mode === 'merge' && d.i === n - 2 ? 'url(#sc-a-bad)' : 'url(#sc-a)'} />
  ))}

  {/* merge: the final node is its own successor, so it receives two arrows —
      one from the node before it and one from itself. That is S(n−2) = S(n−1),
      with n−2 ≠ n−1, which is exactly what A8 forbids. */}
  {mode === 'merge' && n >= 2 && (() => {
    const last = nodes[n - 1];
    return (
      <g>
        <path d={`M ${last.x - 9} ${last.y - R - 2}
                  C ${last.x - 34} ${last.y - R - 40},
                    ${last.x + 34} ${last.y - R - 40},
                    ${last.x + 9} ${last.y - R - 2}`}
              class="arr-bad" marker-end="url(#sc-a-bad)" />
        <text x={last.x} y={last.y - R - 46} class="note" text-anchor="middle">two into one</text>
      </g>
    );
  })()}

  {/* loop: last node curves back to the first */}
  {mode === 'loop' && (
    <g>
      <path d={`M ${nodes[n - 1].x} ${nodes[n - 1].y + R + 3}
                Q ${(nodes[0].x + nodes[n - 1].x) / 2} ${nodes[0].y + 62}
                  ${nodes[0].x} ${nodes[0].y + R + 3}`}
            class="arr-bad" marker-end="url(#sc-a-bad)" />
      <text x={(nodes[0].x + nodes[n - 1].x) / 2} y={nodes[0].y + 60}
            class="note" text-anchor="middle">back to 0</text>
    </g>
  )}

  {nodes.map((d) => (
    <g>
      <circle cx={d.x} cy={d.y} r={R}
              class={(mode === 'loop' && d.i === 0) ? 'node-bad' : 'node'} />
      <text x={d.x} y={d.y + 4} class="lbl" text-anchor="middle">{d.label}</text>
    </g>
  ))}

  {trailing && (
    <text x={nodes[n - 1].x + GAP - 22} y={ROW_Y + 6} class="dots">…</text>
  )}

  {/* rogue: a disconnected two-cycle below the chain */}
  {mode === 'rogue' && (() => {
    const ax = LEFT + 118;
    const bx = ax + 86;
    const y = ROW_Y + 78;
    return (
      <g>
        <path d={`M ${ax + R + 3} ${y - 7} Q ${(ax + bx) / 2} ${y - 34} ${bx - R - 3} ${y - 7}`}
              class="arr" marker-end="url(#sc-a)" />
        <path d={`M ${bx - R - 3} ${y + 7} Q ${(ax + bx) / 2} ${y + 34} ${ax + R + 3} ${y + 7}`}
              class="arr" marker-end="url(#sc-a)" />
        <circle cx={ax} cy={y} r={R} class="node-bad" />
        <text x={ax} y={y + 4} class="lbl" text-anchor="middle">{rogueLabels[0]}</text>
        <circle cx={bx} cy={y} r={R} class="node-bad" />
        <text x={bx} y={y + 4} class="lbl" text-anchor="middle">{rogueLabels[1]}</text>
        <text x={bx + 40} y={y + 4} class="note">unreachable from 0</text>
      </g>
    );
  })()}
</svg>

<style>
  .succ-chain { width: 100%; height: auto; max-width: 480px; display: block; margin: 0 auto; }
</style>
