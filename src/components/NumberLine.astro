---
// A number line with tick marks, labelled points, and intervals.
//
// from / to      the visible range
// ticks          numbers to draw a tick at; defaults to every integer in range
// labels         which ticks get a printed label; defaults to `ticks`
// points         [{ at, label?, open? }] dots on the line; open renders a hollow dot
// intervals      [{ from, to, openLeft?, openRight?, label? }] shaded spans
//                An unbounded end is written as null and renders as an arrow.
// gapAt          marks a missing point with a hollow circle and a dashed drop-line —
//                for §4.6/§4.7, where ℚ is dense and still has holes.
export interface Props {
  from?: number;
  to?: number;
  ticks?: number[] | null;
  labels?: number[] | null;
  points?: { at: number; label?: string; open?: boolean }[];
  intervals?: {
    from: number | null;
    to: number | null;
    openLeft?: boolean;
    openRight?: boolean;
    label?: string;
  }[];
  gapAt?: { at: number; label?: string } | null;
  caption?: string | null;
}
const {
  from = -5,
  to = 5,
  ticks = null,
  labels = null,
  points = [],
  intervals = [],
  gapAt = null,
} = Astro.props;

const W = 480;
const PAD = 30;
const AXIS_Y = 96;
const span = to - from || 1;
// Map a number to an x coordinate; clamp so an out-of-range value cannot escape the box.
const X = (v: number) => {
  const t = (v - from) / span;
  return PAD + Math.max(0, Math.min(1, t)) * (W - 2 * PAD);
};

const defaultTicks = () => {
  const out: number[] = [];
  const first = Math.ceil(from);
  const last = Math.floor(to);
  // Keep the axis readable: thin the ticks out if the range is wide.
  const step = Math.max(1, Math.ceil((last - first + 1) / 14));
  for (let v = first; v <= last; v += step) out.push(v);
  return out;
};
const tickList = ticks ?? defaultTicks();
const labelList = labels ?? tickList;
const isLabelled = (v: number) => labelList.some((l) => Math.abs(l - v) < 1e-9);

const fmt = (v: number) => (Number.isInteger(v) ? String(v) : String(v));

// Alt text has to carry the mathematics, not just say "a number line".
const describeInterval = (i: Props['intervals'][number]) => {
  const l = i.from === null ? 'unbounded below' : `${i.openLeft ? 'excluding' : 'including'} ${fmt(i.from)}`;
  const r = i.to === null ? 'unbounded above' : `${i.openRight ? 'excluding' : 'including'} ${fmt(i.to)}`;
  return `an interval ${l} to ${r}`;
};
const alt = [
  `A number line from ${fmt(from)} to ${fmt(to)}.`,
  points.length ? `Marked points: ${points.map((p) => p.label ?? fmt(p.at)).join(', ')}.` : '',
  intervals.length ? `Shaded: ${intervals.map(describeInterval).join('; ')}.` : '',
  gapAt ? `A hollow circle at ${gapAt.label ?? fmt(gapAt.at)} marks a location with no number of the kind under discussion.` : '',
].filter(Boolean).join(' ');
---
<svg viewBox={`0 0 ${W} 150`} xmlns="http://www.w3.org/2000/svg" class="number-line"
     role="img" aria-label={alt}>
  <style>
    .number-line .axis { stroke: var(--color-ink, #14182B); stroke-width: 1.6; }
    .number-line .tick { stroke: var(--color-ink, #14182B); stroke-width: 1.2; }
    .number-line .tlbl { font-family: var(--font-mono, monospace); font-size: 11px; fill: color-mix(in oklab, var(--color-ink, #14182B) 75%, transparent); }
    .number-line .band { stroke: var(--color-signal, #3F6DB5); stroke-width: 6; stroke-linecap: butt; opacity: 0.32; }
    .number-line .dot { fill: var(--color-signal, #3F6DB5); }
    .number-line .dot-open { fill: var(--color-bg, #FFFFFF); stroke: var(--color-signal, #3F6DB5); stroke-width: 2; }
    .number-line .gap { fill: var(--color-bg, #FFFFFF); stroke: var(--color-false, #A8324A); stroke-width: 2; }
    .number-line .gapline { stroke: var(--color-false, #A8324A); stroke-width: 1.2; stroke-dasharray: 3 3; }
    .number-line .plbl { font-family: var(--font-mono, monospace); font-size: 12px; fill: var(--color-ink, #14182B); }
    .number-line .glbl { font-family: var(--font-mono, monospace); font-size: 12px; fill: var(--color-false, #A8324A); }
  </style>

  <defs>
    <marker id="nl-arrow" viewBox="0 0 10 10" refX="9" refY="5"
            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-ink, #14182B)" />
    </marker>
    <marker id="nl-arrow-band" viewBox="0 0 10 10" refX="9" refY="5"
            markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-signal, #3F6DB5)" opacity="0.5" />
    </marker>
  </defs>

  {/* Shaded intervals sit under the axis line so the axis stays crisp. */}
  {intervals.map((i) => {
    const x1 = i.from === null ? PAD - 12 : X(i.from);
    const x2 = i.to === null ? W - PAD + 12 : X(i.to);
    return (
      <g>
        <line x1={x1} y1={AXIS_Y} x2={x2} y2={AXIS_Y} class="band"
              marker-start={i.from === null ? 'url(#nl-arrow-band)' : undefined}
              marker-end={i.to === null ? 'url(#nl-arrow-band)' : undefined} />
        {i.from !== null && (
          <circle cx={X(i.from)} cy={AXIS_Y} r="5"
                  class={i.openLeft ? 'dot-open' : 'dot'} />
        )}
        {i.to !== null && (
          <circle cx={X(i.to)} cy={AXIS_Y} r="5"
                  class={i.openRight ? 'dot-open' : 'dot'} />
        )}
        {i.label && (
          <text x={(x1 + x2) / 2} y={AXIS_Y - 22} class="plbl" text-anchor="middle">{i.label}</text>
        )}
      </g>
    );
  })}

  <line x1={PAD - 16} y1={AXIS_Y} x2={W - PAD + 16} y2={AXIS_Y} class="axis"
        marker-start="url(#nl-arrow)" marker-end="url(#nl-arrow)" />

  {tickList.map((v) => (
    <g>
      <line x1={X(v)} y1={AXIS_Y - 6} x2={X(v)} y2={AXIS_Y + 6} class="tick" />
      {isLabelled(v) && (
        <text x={X(v)} y={AXIS_Y + 24} class="tlbl" text-anchor="middle">{fmt(v)}</text>
      )}
    </g>
  ))}

  {points.map((p) => (
    <g>
      <circle cx={X(p.at)} cy={AXIS_Y} r="5.5" class={p.open ? 'dot-open' : 'dot'} />
      {p.label && (
        <text x={X(p.at)} y={AXIS_Y - 16} class="plbl" text-anchor="middle">{p.label}</text>
      )}
    </g>
  ))}

  {gapAt && (
    <g>
      <line x1={X(gapAt.at)} y1={AXIS_Y - 30} x2={X(gapAt.at)} y2={AXIS_Y} class="gapline" />
      <circle cx={X(gapAt.at)} cy={AXIS_Y} r="5.5" class="gap" />
      <text x={X(gapAt.at)} y={AXIS_Y - 38} class="glbl" text-anchor="middle">{gapAt.label ?? 'gap'}</text>
    </g>
  )}
</svg>

<style>
  .number-line { width: 100%; height: auto; max-width: 480px; display: block; margin: 0 auto; }
</style>
