---
import BaseLayout from './BaseLayout.astro';
import LevelRail from '@/components/LevelRail.astro';
import BigIdea from '@/components/BigIdea.astro';
import Needs from '@/components/Needs.astro';
import {
  getAllModules,
  chapterTitle as chapterTitleFor,
  hasModuleMDX,
  modulePath,
  chapterPath,
  type LevelId,
} from '@/lib/content';
import type { ModuleContract } from '@/content.config';

export interface Props {
  level: LevelId;
  module: ModuleContract;
  chapterSlug: string;
  chapterNumber: number;
  chapterTitle: string;
  isTouch: boolean;
}
const { level, module, chapterSlug, chapterNumber, chapterTitle, isTouch } = Astro.props;
const title = module.titles[level] ?? module.titles.l7 ?? module.slug;

// Prefer the per-level kernel; fall back to the legacy singular kernel for
// modules whose per-level kernels haven't been authored yet.
const kernelSentence = module.kernels?.[level] ?? module.kernel;

// Neighbors across the whole course at this level, not just inside the current
// chapter. Scoping this to the chapter left the reader stranded at §1.12 with
// no way forward but the contents menu — the pager is how you read a book
// straight through, so it has to cross the seam.
const all = getAllModules();
const idx = all.findIndex(
  (x) => x.chapter.slug === chapterSlug && x.module.id === module.id,
);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const railHref = (id: LevelId) => modulePath(id, chapterSlug, module.slug);
---
<BaseLayout title={`${module.id} · ${title}`} level={level}
            description={module.kernel}>
  <div class="site-grid">
    <LevelRail currentLevel={level} hrefFor={railHref} />

    <main class="reader">
      <header class="module-header">
        <div class="module-eyebrow">
          <a href={chapterPath(level, chapterSlug)}>Ch {chapterNumber} · {chapterTitle}</a>
          {' · '}
          <span>Module {module.id}</span>
        </div>
        <h1>{title}</h1>
      </header>

      {module.prerequisites.length > 0 && (
        <Needs ids={module.prerequisites} level={level} />
      )}

      <BigIdea sentence={kernelSentence} level={level} />

      {isTouch && (
        <p class="touch-notice">
          A short, honest first look at this idea here. It's told in full from grade 5 up —
          <a href={modulePath('l3', chapterSlug, module.slug)}> read the longer version</a>.
        </p>
      )}

      <article>
        <slot />
      </article>

      <nav aria-label="Neighboring modules" style="display:flex; gap:1rem; justify-content:space-between; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--color-rule);">
        <div>
          {prev && (
            <a href={modulePath(level, prev.chapter.slug, prev.module.slug)}>
              {prev.chapter.slug !== chapterSlug && (
                <span class="pager-chapter">Ch {prev.chapter.number} · {chapterTitleFor(prev.chapter, level)}</span>
              )}
              <span>← {prev.module.id} · {prev.module.titles[level] ?? prev.module.titles.l7}</span>
            </a>
          )}
        </div>
        <div class="pager-next">
          {next && (
            <a href={modulePath(level, next.chapter.slug, next.module.slug)}>
              {next.chapter.slug !== chapterSlug && (
                <span class="pager-chapter">Ch {next.chapter.number} · {chapterTitleFor(next.chapter, level)}</span>
              )}
              <span>{next.module.id} · {next.module.titles[level] ?? next.module.titles.l7} →</span>
            </a>
          )}
        </div>
      </nav>
    </main>

    <aside class="margin-col" aria-label="Margin notes">
      <div class="small mono" style="color: color-mix(in oklab, var(--color-ink) 60%, transparent); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem;">
        Source
      </div>
      <div class="small">{module.sourceRef}</div>
      {module.namedMove && (
        <>
          <div class="small mono" style="color: color-mix(in oklab, var(--color-ink) 60%, transparent); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 1.5rem; margin-bottom: 0.5rem;">
            Named move
          </div>
          <div class="small"><em>{module.namedMove}</em></div>
        </>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  /* The pager crosses chapter boundaries, so when the next module lives in a
     different chapter the link says which one — otherwise the reader steps from
     "1.12 Four ways to be right" to "2.1 The toy box" with no idea a chapter
     ended. Stacked above the module line, and quieter than it. */
  .pager-chapter {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, var(--color-ink) 55%, transparent);
    margin-bottom: 0.15rem;
  }
  .pager-next { text-align: right; }
</style>
